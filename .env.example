# --- OpenRouter (server-side only — never exposed to the browser) ------------
# Get a key at https://openrouter.ai/keys. Add the production value in
# Hostinger hPanel under the Node.js application's Environment Variables.
OPENROUTER_API_KEY=
NEXT_PUBLIC_APP_URL=https://lab.aithreesixty.tech

# --- Authentication ----------------------------------------------------------
# Reuse the existing AI 360 Clerk application so the main site and Lab share
# one user pool. These names are required by @clerk/nextjs. Never expose
# CLERK_SECRET_KEY.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dedicated branded account pages and safe fallback destinations.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
# Signing secret for https://lab.aithreesixty.tech/api/webhooks/clerk.
# This is separate from CLERK_SECRET_KEY and must remain server-side.
CLERK_WEBHOOK_SIGNING_SECRET=
# Restrict which first-party origins may present Clerk session tokens.
CLERK_AUTHORIZED_PARTIES=https://aithreesixty.tech,https://lab.aithreesixty.tech
# Enable only after Clerk Organizations use optional membership and the pilot
# team-workspace flow has passed tenant-isolation testing.
NEXT_PUBLIC_AI360_TEAM_WORKSPACES=false

# --- Billing and payments ----------------------------------------------------
# Keep checkout provider-neutral inside AI 360. MojoPay is the first Ghana
# adapter, with Mobile Money presented before cards. Checkout stays disabled
# until the signed webhook contract and merchant sandbox have been verified.
NEXT_PUBLIC_BILLING_ENABLED=false
PAYMENTS_PROVIDER=mojopay
MOJOPAY_API_BASE_URL=
MOJOPAY_MERCHANT_ID=
MOJOPAY_SECRET_KEY=
MOJOPAY_WEBHOOK_SECRET=

# --- Hostinger MySQL ---------------------------------------------------------
# Recommended: create a dedicated ai360_lab database and least-privilege user
# on the same Hostinger MySQL service as the informational website.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai360_lab
MYSQL_USER=
MYSQL_PASSWORD=

# --- Supabase Postgres migration target --------------------------------------
# Keep DATABASE_PROVIDER=mysql until the application data-route cutover is
# complete. For Hostinger's persistent Node runtime, use Supabase's shared
# session-pooler URL (port 5432) for DATABASE_URL. Keep the direct connection
# string for migrations; if the host cannot reach its IPv6 endpoint, use the
# session pooler for migrations or apply the SQL in Supabase's SQL Editor.
DATABASE_PROVIDER=mysql
DATABASE_URL=
DIRECT_URL=
DATABASE_POOL_SIZE=5
DATABASE_SSL=require
# These public values are only required when Storage or Realtime is connected
# from the browser. Never expose a service-role key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required later by server-only Storage operations. Never expose this value in
# a NEXT_PUBLIC_ variable or browser bundle.
SUPABASE_SECRET_KEY=
SUPABASE_PRIVATE_BUCKET=ai360-private

# Optional: shown to OpenRouter for attribution / rankings.
OPENROUTER_SITE_URL=https://lab.aithreesixty.tech
OPENROUTER_SITE_NAME=AI 360 Lab

# Optional media models used by the Studio execution layer.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1-mini
# Optional comma-separated failover order. When omitted, Studio falls back to
# Google Nano Banana 2 Lite automatically.
OPENROUTER_IMAGE_MODELS=openai/gpt-image-1-mini,google/gemini-3.1-flash-lite-image
OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite

# Optional public-launch limits. Defaults are applied when these are omitted.
AI360_RATE_CHAT_PER_MINUTE=12
AI360_RATE_CHAT_PER_DAY=80
AI360_RATE_AGENT_PER_MINUTE=4
AI360_RATE_AGENT_PER_DAY=16
AI360_RATE_STUDIO_PER_MINUTE=5
AI360_RATE_STUDIO_PER_DAY=24
AI360_RATE_STUDIO_IMAGE_PER_MINUTE=2
AI360_RATE_STUDIO_IMAGE_PER_DAY=8
AI360_RATE_STUDIO_VIDEO_PER_MINUTE=1
AI360_RATE_STUDIO_VIDEO_PER_DAY=3
AI360_RATE_VOICE_PER_MINUTE=5
AI360_RATE_VOICE_PER_DAY=24
