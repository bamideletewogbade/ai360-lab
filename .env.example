# ==============================================================================
# AI360 â€” PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# 1. CANONICAL APP URL
NEXT_PUBLIC_APP_URL=https://lab.aithreesixty.tech
# Optional emergency override. Normal builds derive this automatically from
# the Git commit and persist it for Next.js version-skew protection.
# AI360_DEPLOYMENT_ID_OVERRIDE=release_identifier_from_ci

# 2. OPENROUTER AI GATEWAY
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=https://lab.aithreesixty.tech

# 3. SUPABASE POSTGRES DATABASE PLANE
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://user:password@db.xxx.supabase.co:5432/postgres
DIRECT_URL=postgresql://user:password@db.xxx.supabase.co:5432/postgres
DATABASE_SSL=require
DATABASE_POOL_SIZE=5

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_PRIVATE_BUCKET=ai360-private

# 4. CLERK AUTHENTICATION
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_key_here
CLERK_SECRET_KEY=sk_live_your_key_here
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_secret_here

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
CLERK_AUTHORIZED_PARTIES=https://aithreesixty.tech,https://lab.aithreesixty.tech

# 5. EXPRESSPAY GHANA BILLING GATEWAY
# Keep checkout closed until `npm run payments:sandbox` passes with sandbox
# credentials. Production deployment uses `live` only after that review.
NEXT_PUBLIC_BILLING_ENABLED=false
PAYMENTS_PROVIDER=expresspay
EXPRESSPAY_ENV=sandbox
EXPRESSPAY_MERCHANT_ID=your_expresspay_merchant_id
EXPRESSPAY_API_KEY=your_expresspay_api_key

# 6. RESEND TRANSACTIONAL EMAIL
# Disabled until the sending domain is verified in Resend. Clerk still sends its
# own auth email (verification, password reset); this plane is for application
# mail such as payment receipts and welcome messages.
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=AI360 <lab@aithreesixty.tech>
EMAIL_REPLY_TO=support@aithreesixty.tech
# Comma-separated staff addresses that receive urgent (S0/S1) quality alerts.
AI360_QUALITY_ALERT_EMAILS=
# Balance at or below which a low-credit notice may be sent, in credits.
AI360_LOW_CREDIT_THRESHOLD=5

# 7. FEATURE FLAGS
NEXT_PUBLIC_AI360_TEAM_WORKSPACES=false
AI360_BROWSER_PILOT_ENABLED=false
