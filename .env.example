# ==============================================================================
# AI360 - PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# 1. CANONICAL APP URL
NEXT_PUBLIC_APP_URL=https://ai360.africa
AI360_DEPLOYMENT_ENV=production
# Optional emergency override. Normal builds derive this automatically from
# the Git commit and persist it for Next.js version-skew protection.
# AI360_DEPLOYMENT_ID_OVERRIDE=release_identifier_from_ci

# 2. OPENROUTER AI GATEWAY
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=https://ai360.africa
OPENROUTER_SITE_NAME=AI360
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1-mini
OPENROUTER_IMAGE_MODELS=openai/gpt-image-1-mini,google/gemini-3.1-flash-lite-image
OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite

# 3. SUPABASE POSTGRES + AUTH PLANE
DATABASE_PROVIDER=postgres
# Hostinger is a persistent IPv4 Node.js runtime. Use the Supabase shared
# session pooler on port 5432. Percent-encode special password characters.
DATABASE_URL=postgresql://postgres.project_ref:encoded_password@aws-0-region.pooler.supabase.com:5432/postgres
# Keep a reviewed migration connection separate. It may use the same session
# pooler when the direct IPv6 database endpoint is not reachable.
DIRECT_URL=postgresql://postgres.project_ref:encoded_password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_SSL=require
DATABASE_POOL_SIZE=5

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_service_role_or_secret_key_here
SUPABASE_PRIVATE_BUCKET=ai360-private

# 4. EXPRESSPAY GHANA BILLING GATEWAY
# Keep checkout closed for the database repair deploy. Set the live provider
# values, redeploy, verify /api/ready, then change only the feature flag to true
# for the controlled real-money pilot.
NEXT_PUBLIC_BILLING_ENABLED=false
PAYMENTS_PROVIDER=expresspay
EXPRESSPAY_ENV=live
EXPRESSPAY_MERCHANT_ID=your_expresspay_merchant_id
EXPRESSPAY_API_KEY=your_expresspay_api_key

# 5. RESEND TRANSACTIONAL EMAIL
# Disabled until the sending domain is verified in Resend. Supabase Auth sends
# auth email (verification, password reset); this plane is for application mail
# such as payment receipts and welcome messages.
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=AI360 <noreply@ai360.africa>
EMAIL_REPLY_TO=support@ai360.africa
# Comma-separated staff addresses that receive urgent (S0/S1) quality alerts.
AI360_QUALITY_ALERT_EMAILS=
# Balance at or below which a low-credit notice may be sent, in credits.
AI360_LOW_CREDIT_THRESHOLD=5

# 6. SPEND CAPS (circuit breaker on real provider spend)
# Ceilings in US dollars of measured provider cost per UTC day, read from
# lab_cost_ledger. Credits bound what one person may consume; these bound what
# AI360 actually pays, which credits cannot do for sponsored seats, mis-set
# credit weights or a retrying agent.
#
# Leave unset to take the built-in defaults below — an unconfigured deployment
# still has a ceiling. Set "off" to disable a scope deliberately; a malformed
# value falls back to the default rather than to no limit.
# Reference: a whole Everyday month is ~$2.07, an image ~$0.003, a 4s video
# ~$0.14. Video is roughly 180x a chat turn, so it is what a cap actually binds.
AI360_SPEND_CAP_DAILY_USD=25
AI360_SPEND_CAP_WORKSPACE_DAILY_USD=5
AI360_SPEND_CAP_USER_DAILY_USD=5

# A cumulative programme budget: a hard stop once a named pot of money is
# spent. Unlike the daily caps this has NO default, because it is a claim about
# somebody's actual funds. Both values are required together — an amount with
# no start date would silently count every dollar ever spent.
# Watch it with `npm run spend:verify`.
# Current pilot ceiling. Keep the start date at or before the first pilot usage
# so earlier test activity is not excluded from the same pot of money.
# AI360_SPEND_CAP_TOTAL_USD=20
# AI360_SPEND_CAP_SINCE=2026-08-26

# 7. FEATURE FLAGS
NEXT_PUBLIC_AI360_TEAM_WORKSPACES=false
AI360_BROWSER_PILOT_ENABLED=false

# Private, server-side access to /pilot and /api/pilot/cohorts. Prefer account
# IDs; the verified sign-in email allowlist is provided for easier setup.
AI360_PILOT_OPERATOR_IDS=
AI360_PILOT_OPERATOR_EMAILS=

# 8. OBSERVABILITY
# Sentry error + performance monitoring (free Developer plan). The DSN is
# public by design: NEXT_PUBLIC_SENTRY_DSN is inlined into the browser bundle
# for client-side errors, and SENTRY_DSN (server-only, optional) overrides it.
# Without both, the SDK is inert and the app behaves exactly as before.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional: upload source maps at build for readable stack traces. Requires a
# Sentry auth token plus org and project slugs in the build environment.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Axiom log aggregation (free tier). Set both to ship the structured JSON log
# lines for search, retention and alerting; console output remains the
# backstop and is always written regardless.
AXIOM_TOKEN=
AXIOM_DATASET=
