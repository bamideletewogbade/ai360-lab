{
  "name": "ai360-lab",
  "version": "0.1.0",
  "description": "AI360 - a practical AI workspace. Streaming chat over OpenRouter with primary + fallback routing (the AI gateway pattern), agent and Studio workflows, credits and payments.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "node scripts/build.mjs",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "test": "node --import ./scripts/register-alias.mjs --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:postgres:migrate": "node scripts/migrate-postgres.mjs",
    "db:postgres:verify": "node scripts/verify-postgres.mjs",
    "credits:verify": "node --experimental-strip-types scripts/verify-credits.mjs",
    "spend:verify": "node --experimental-strip-types scripts/verify-spend-caps.mjs",
    "email:verify": "node --experimental-strip-types scripts/verify-email.mjs",
    "credits:pilot": "node scripts/grant-pilot-credits.mjs",
    "payments:contract": "node --import ./scripts/register-alias.mjs --experimental-strip-types --test tests/expresspay.test.ts tests/billing.test.ts",
    "payments:sandbox": "node --experimental-strip-types scripts/test-expresspay-sandbox.mjs",
    "payments:verify": "node --experimental-strip-types scripts/verify-payments.mjs",
    "data:verify": "node --experimental-strip-types scripts/verify-data-routes.mjs",
    "runs:verify": "node --experimental-strip-types scripts/verify-run-recovery.mjs",
    "media:verify": "node --experimental-strip-types scripts/verify-media-catalogue.mjs",
    "domains:verify": "node --experimental-strip-types scripts/verify-domains.mjs",
    "prod:check": "node scripts/check-production.mjs",
    "smoke:deploy": "node scripts/smoke-deployment.mjs",
    "smoke:pilot": "node scripts/smoke-pilot-production.mjs",
    "smoke:documents": "node scripts/smoke-chat-documents.mjs",
    "release:check": "npm audit --omit=dev && npm run lint && npm test && npm run build && npm run prod:check",
    "video:dev": "remotion studio src/remotion/index.ts",
    "video:render": "remotion render src/remotion/index.ts AI360Explainer out/ai360-explainer.mp4",
    "video:render:short": "remotion render src/remotion/index.ts AI360SocialShort out/ai360-social-short.mp4",
    "video:render:fast": "remotion render src/remotion/index.ts AI360FastDemo out/ai360-fast-demo.mp4",
    "video:render:all": "npm run video:render && npm run video:render:short && npm run video:render:fast"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "cross-env": "^7.0.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.7.1",
    "dotenv": "^16.6.1",
    "jszip": "^3.10.1",
    "motion": "^13.1.1",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.517",
    "@remotion/paths": "^4.0.517",
    "@remotion/player": "^4.0.517",
    "@remotion/shapes": "^4.0.517",
    "@remotion/transitions": "^4.0.517",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.4.2",
    "remotion": "^4.0.517",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "22.x"
  }
}
